# Copy this file to `.env.local`.
# PlatformIO now auto-loads `.env.local` at build time.
# Exporting these in your shell is still supported and takes precedence.

ESP32_WIFI_SSID=your-wifi-ssid
ESP32_WIFI_PASSWORD=your-wifi-password
ESP32_FALLBACK_AP_SSID_PREFIX=esp32-status
ESP32_FALLBACK_AP_PASSWORD=change-me-ap

# Optional station hostname/mDNS identity.
# By default the firmware appends the last 6 MAC hex digits, for example
# esp32-status-577180.local, so multiple ESP32 boards do not fight over one name.
# ESP32_STATUS_HOST_NAME=esp32-status
# ESP32_STATUS_HOST_NAME_APPEND_MAC=true

# Optional board-voltage sensing. Leave unset to disable.
# Use an ADC1 pin such as GPIO34 and a resistor divider if the source can exceed 3.3V.
# Example for a 100k/100k divider that halves the source voltage:
# ESP32_POWER_SENSE_PIN=34
# ESP32_POWER_SENSE_DIVIDER_RATIO=2.0
# ESP32_POWER_SENSE_OFFSET_MV=0

# Optional SPI SD card reader. Defaults match common ESP32 WROOM VSPI wiring.
# The card is only read when requested from the SD Card page.
# Set ESP32_SD_CARD_ENABLED=false to disable SD card management.
# ESP32_SD_CARD_ENABLED=true
# ESP32_SD_CARD_CS_PIN=5
# ESP32_SD_CARD_SCK_PIN=18
# ESP32_SD_CARD_MISO_PIN=19
# ESP32_SD_CARD_MOSI_PIN=23
# ESP32_SD_CARD_SPI_FREQUENCY_HZ=4000000
