# Copy this file to `.env.local`.
# PlatformIO now auto-loads `.env.local` at build time.
# Exporting these in your shell is still supported and takes precedence.

ESP32_WIFI_SSID=your-wifi-ssid
ESP32_WIFI_PASSWORD=your-wifi-password
ESP32_FALLBACK_AP_SSID_PREFIX=esp32-status
ESP32_FALLBACK_AP_PASSWORD=change-me-ap

# Optional board-voltage sensing. Leave unset to disable.
# Use an ADC1 pin such as GPIO34 and a resistor divider if the source can exceed 3.3V.
# Example for a 100k/100k divider that halves the source voltage:
# ESP32_POWER_SENSE_PIN=34
# ESP32_POWER_SENSE_DIVIDER_RATIO=2.0
# ESP32_POWER_SENSE_OFFSET_MV=0
