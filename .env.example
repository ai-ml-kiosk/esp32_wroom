# Copy this file to `.env.local`.
# PlatformIO now auto-loads `.env.local` at build time.
# Exporting these in your shell is still supported and takes precedence.

ESP32_WIFI_SSID=your-wifi-ssid
ESP32_WIFI_PASSWORD=your-wifi-password
ESP32_FALLBACK_AP_SSID_PREFIX=esp32-status
ESP32_FALLBACK_AP_PASSWORD=change-me-ap
